--- main_before/dashboard/styles.css
+++ main_after/dashboard/styles.css
@@ -105,3 +105,294 @@
 .e1r-panel .mini p{
   overflow-wrap:anywhere;
 }
+
+/* === E1R v0.2 / OOS scoped CSS imported from feature/dashboard/styles.css === */
+
+/* E1-R Research Dashboard Integration */
+.e1r-card{border-color:rgba(29,158,117,.28)}
+
+/* E1R v0.2 OOS-1 Dashboard Status UI */
+.e1r-oos-card{
+  border:1px solid rgba(255,255,255,.10);
+  border-left:4px solid #a78bfa;
+  border-radius:14px;
+  padding:16px;
+  margin:0 0 16px 0;
+  background:rgba(167,139,250,.06);
+  box-shadow:0 8px 24px rgba(0,0,0,.14);
+}
+
+.e1r-oos-main{
+  display:flex;
+  align-items:flex-start;
+  justify-content:space-between;
+  gap:12px;
+  margin-bottom:12px;
+}
+
+.e1r-oos-label{
+  font-size:12px;
+  opacity:.72;
+  letter-spacing:.04em;
+  text-transform:uppercase;
+}
+
+.e1r-oos-value{
+  font-size:24px;
+  font-weight:800;
+  line-height:1.15;
+  margin-top:4px;
+}
+
+.e1r-oos-date{
+  font-size:12px;
+  opacity:.72;
+  white-space:nowrap;
+  margin-top:4px;
+}
+
+.e1r-oos-grid{
+  display:grid;
+  grid-template-columns:repeat(6,minmax(0,1fr));
+  gap:10px;
+  margin-top:10px;
+}
+
+.e1r-oos-grid div{
+  border:1px solid rgba(255,255,255,.08);
+  border-radius:10px;
+  padding:10px;
+  background:rgba(0,0,0,.12);
+}
+
+.e1r-oos-grid span{
+  display:block;
+  font-size:11px;
+  opacity:.65;
+  margin-bottom:4px;
+}
+
+.e1r-oos-grid b{
+  display:block;
+  font-size:13px;
+  overflow:hidden;
+  text-overflow:ellipsis;
+  white-space:nowrap;
+}
+
+.e1r-oos-note{
+  margin-top:12px;
+  font-size:12px;
+  line-height:1.5;
+  opacity:.72;
+}
+
+@media (max-width: 1100px){
+  .e1r-oos-grid{
+    grid-template-columns:repeat(3,minmax(0,1fr));
+  }
+}
+
+@media (max-width: 700px){
+  .e1r-oos-main{
+    display:block;
+  }
+  .e1r-oos-date{
+    margin-top:8px;
+  }
+  .e1r-oos-grid{
+    grid-template-columns:repeat(2,minmax(0,1fr));
+  }
+}
+
